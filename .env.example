# Local run (uv run fastapi dev) talks to the Postgres from docker compose on the host port below.
# Inside docker compose the app overrides DATABASE_URL to reach the "db" service.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5434/payments
SECRET_KEY=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Tashkent

# Host ports used by docker compose
DB_HOST_PORT=5434
APP_HOST_PORT=8000
